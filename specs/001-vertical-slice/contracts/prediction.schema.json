{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VouchIQ Prediction (extended record)",
  "type": "object",
  "required": ["row_id", "invoice_number", "voucher_type"],
  "properties": {
    "row_id": {"type": "integer", "minimum": 1},
    "invoice_number": {"type": "string", "minLength": 1},
    "voucher_type": {"type": "string", "enum": ["Purchase", "Sales", "Import", "Export", "Purchase Return / Debit Note", "Sales Return / Credit Note", "Rejection Out", "Rejection In", "Payment", "Receipt", "Contra", "Advance / Prepayment", "Journal", "Expense", "Other / Miscellaneous", "Salary / Payroll", "Attendance", "Purchase Order", "Sales Order", "Receipt Note", "Delivery Note", "Material In", "Material Out", "Job Work In Order", "Job Work Out Order", "Stock Journal", "Physical Stock"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "needs_review": {"type": "boolean"},
    "top_k": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "number"}], "minItems": 2, "maxItems": 2}},
    "evidence": {"type": "array", "items": {"type": "string"}}
  }
}
